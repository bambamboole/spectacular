{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bambamboole/spectacular",
    "description": "OpenAPI and AsyncAPI tooling for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "openapi",
        "asyncapi",
        "scramble",
        "spatie-query-builder"
    ],
    "authors": [
        {
            "name": "Manuel Christlieb",
            "email": "manuel@christlieb.eu"
        }
    ],
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13.30",
        "illuminate/support": "^13.0",
        "league/openapi-psr7-validator": "^0.24",
        "nyholm/psr7": "^1.8",
        "spatie/laravel-query-builder": "^7.0",
        "symfony/psr-http-message-bridge": "^8.0"
    },
    "require-dev": {
        "bambamboole/extended-testbench": "^0.6",
        "bambamboole/laravel-webhooks": ">=0.3 <1.0.0",
        "brick/math": "^0.18",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "rector/rector": "^2.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-model-states": "^2.14"
    },
    "suggest": {
        "bambamboole/laravel-webhooks": "Document webhook events alongside broadcasts in the generated AsyncAPI (>=0.3).",
        "spatie/laravel-model-states": "Document model state properties as string enum schemas in the generated OpenAPI (^2.0).",
        "lattice-php/api-reference": "Render the generated OpenAPI documents as a browsable API reference (Lattice component, ^0.42).",
        "spatie/laravel-data": "Document the request body of actions taking a Data object, descriptions included (^4.23).",
        "brick/math": "Type BigDecimal directly on Data properties: auto-registered cast/transformer plus an OpenAPI schema accepting number and decimal string."
    },
    "autoload": {
        "psr-4": {
            "Bambamboole\\Spectacular\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bambamboole\\Spectacular\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "check": [
            "pint --test",
            "phpstan analyse",
            "@test"
        ],
        "lint": "pint --format agent",
        "stan": "phpstan analyse",
        "test:lint": "./vendor/bin/pint --test",
        "test": "pest",
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi",
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "post-install-cmd": [
            "@boost:refresh"
        ],
        "post-update-cmd": [
            "@boost:refresh"
        ],
        "boost:refresh": "[ -n \"$CI\" ] || [ ! -f vendor/bin/testbench ] || [ ! -f boost.json ] || vendor/bin/testbench boost:update --no-interaction || true",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "refactor": "rector"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bambamboole\\Spectacular\\SpectacularServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
