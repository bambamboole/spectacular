{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bambamboole/spectacular",
    "description": "OpenAPI and AsyncAPI tooling for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "openapi",
        "asyncapi",
        "scramble",
        "spatie-query-builder"
    ],
    "authors": [
        {
            "name": "Manuel Christlieb",
            "email": "manuel@christlieb.eu"
        }
    ],
    "require": {
        "php": "^8.4",
        "bambamboole/laravel-webhooks": "^0.2",
        "dedoc/scramble": "^0.13.30",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.16 || ^2.0",
        "spatie/laravel-query-builder": "^7.0"
    },
    "require-dev": {
        "bambamboole/extended-testbench": "^0.6",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "lattice-php/lattice": "^0.38",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "rector/rector": "^2.0"
    },
    "suggest": {
        "lattice-php/lattice": "Render the generated OpenAPI/AsyncAPI documents as a UI with the Spectacular Lattice viewer (^0.38)."
    },
    "autoload": {
        "psr-4": {
            "Bambamboole\\Spectacular\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bambamboole\\Spectacular\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "check": [
            "pint --test",
            "phpstan analyse",
            "@test"
        ],
        "lint": "pint --format agent",
        "stan": "phpstan analyse",
        "test:lint": "./vendor/bin/pint --test",
        "test": "pest",
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi",
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "post-install-cmd": [
            "@boost:refresh"
        ],
        "post-update-cmd": [
            "@boost:refresh"
        ],
        "boost:refresh": "[ -n \"$CI\" ] || [ ! -f vendor/bin/testbench ] || [ ! -f boost.json ] || vendor/bin/testbench boost:update --no-interaction || true",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test:browser": [
            "npm run build",
            "pest --testsuite=Browser"
        ],
        "refactor": "rector"
    },
    "extra": {
        "lattice": {
            "plugin": "resources/js/plugin.ts",
            "discover": [
                "src"
            ]
        },
        "laravel": {
            "providers": [
                "Bambamboole\\Spectacular\\SpectacularServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
